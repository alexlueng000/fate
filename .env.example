# ============================================
# 环境配置模板
# 复制此文件为 .env 并填入实际值
# ============================================

# -----------------------------
# 环境标识
# -----------------------------
# development | production
APP_ENV=development

# -----------------------------
# 数据库 (MySQL)
# -----------------------------
# 开发环境: mysql+pymysql://fate_app:password@127.0.0.1:3306/fate_dev
# 生产环境: mysql+pymysql://fate_app:password@<生产服务器IP>:3306/fate
DATABASE_URL=mysql+pymysql://fate_app:your_password@127.0.0.1:3306/fate_dev

# -----------------------------
# JWT 认证
# -----------------------------
# 生产环境必须修改为强密钥
JWT_SECRET=change-me-in-production

# -----------------------------
# CORS 跨域
# -----------------------------
# 逗号分隔多个域名，或使用 * 允许所有（仅开发环境）
# 开发环境: *
# 生产环境: https://yizhanmaster.site,https://api.fateinsight.site
CORS_ALLOW_ORIGINS=*

# -----------------------------
# 微信小程序
# -----------------------------
WX_APPID=your_appid
WX_SECRET=your_secret

# -----------------------------
# DeepSeek API
# -----------------------------
DEEPSEEK_API_KEY=sk-xxxxx
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_CONCURRENT=5
DEEPSEEK_ACQUIRE_TIMEOUT=20
DEEPSEEK_RETRY_TIMES=3
DEEPSEEK_RETRY_BASE_DELAY=1.5
DEEPSEEK_TIMEOUT=300

# -----------------------------
# 微信支付 (可选)
# -----------------------------
# dev: 跳过验签（开发环境）
# prod: 严格验签（生产环境）
WECHAT_PAY_MODE=dev
WECHAT_PAY_APPID=
WECHAT_PAY_MCHID=
WECHAT_PAY_MERCHANT_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_PRIVATE_KEY_PEM=
WECHAT_PAY_NOTIFY_URL=https://api.fateinsight.site/api/webhooks/wechatpay
WECHAT_PAY_REFUND_NOTIFY_URL=https://api.fateinsight.site/api/webhooks/wechatpay/refund
WECHAT_API_V3_KEY=
WECHAT_PLATFORM_PUBLIC_KEY_PEM=

# -----------------------------
# Redis
# -----------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------
# 腾讯云短信服务
# -----------------------------
# 开发模式下可以不配置，验证码会输出到日志
TENCENT_SMS_SECRET_ID=your_secret_id
TENCENT_SMS_SECRET_KEY=your_secret_key
TENCENT_SMS_APP_ID=your_app_id
TENCENT_SMS_SIGN=易凡文化
TENCENT_SMS_TEMPLATE_ID=your_template_id

# -----------------------------
# 腾讯云验证码
# -----------------------------
# 开发模式下可设置 CAPTCHA_ENABLED=false 跳过验证码
CAPTCHA_ENABLED=true
TENCENT_CAPTCHA_APP_ID=your_captcha_app_id
TENCENT_CAPTCHA_APP_SECRET=your_captcha_app_secret

# -----------------------------
# SMTP 邮件发送
# -----------------------------
# 163 / QQ 等邮箱请使用客户端授权码，不要使用登录密码。
# 465 通常使用 SSL 直连: SMTP_USE_TLS=true, SMTP_START_TLS=false
# 587 通常使用 STARTTLS: SMTP_USE_TLS=false, SMTP_START_TLS=true
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USERNAME=your_email@163.com
SMTP_PASSWORD=your_smtp_auth_code
SMTP_SENDER=your_email@163.com
SMTP_USE_TLS=true
SMTP_START_TLS=false
